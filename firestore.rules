rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/falleros/$(request.auth.uid)).data.rol == 'admin';
    }
    function isDirectiva() {
      return request.auth != null
        && get(/databases/$(database)/documents/falleros/$(request.auth.uid)).data.rol == 'directiva';
    }
    function isPrivileged() { return isAdmin() || isDirectiva(); }

    // Falleros: cada fallero lee/actualiza su propio perfil; admins y directiva leen todos
    match /falleros/{userId} {
      // Lectura: el propio fallero, staff, o alguien a quien ESTE fallero ha vinculado como familiar
      // (él mismo lo ha decidido al añadirlo a su familiaUids). Nadie más; el resto usa `directorio`.
      allow read: if request.auth != null
        && (request.auth.uid == userId
            || request.auth.uid in resource.data.get('familiaUids', [])
            || isPrivileged());
      // Alta: el número de fallero sólo lo asigna el contador atómico (misma transacción), el rol
      // nace como 'fallero' y los datos oficiales del censo (numeroCenso, distintivo) no se pueden
      // autoasignar: los vuelca la directiva con scripts/syncCenso.js (Admin SDK).
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.numeroFallero ==
           getAfter(/databases/$(database)/documents/metadata/counters).data.ultimoNumeroFallero
        && request.resource.data.get('rol', 'fallero') == 'fallero'
        && !request.resource.data.keys().hasAny(['numeroCenso', 'distintivo']);
      // El usuario edita su perfil, pero NUNCA su número, su rol ni sus datos del censo; sólo un admin
      allow update: if request.auth != null
        && ((request.auth.uid == userId
             && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['numeroFallero', 'rol', 'numeroCenso', 'distintivo']))
            || desvincularmeDe(userId)
            || isAdmin());

      // Vínculo familiar en el doc de OTRO: sólo se permite QUITAR tu propio uid de su familiaUids
      // (rechazar su invitación o desvincularte). Ningún otro campo puede cambiar (ni rol, ni
      // numeroCenso, ni distintivo, ni numeroFallero) y no se puede AÑADIR a nadie: entrar en una
      // familia exige que el titular del doc te añada él mismo (consentimiento).
      function desvincularmeDe(userId) {
        let me     = request.auth.uid;
        let before = resource.data.get('familiaUids', []).toSet();
        let after  = request.resource.data.get('familiaUids', []).toSet();
        return me != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familiaUids'])
          && before.difference(after) == [me].toSet()
          && after.difference(before).size() == 0;
      }
    }

    // Contadores globales: lectura/escritura solo para incrementar en +1 (transacción de registro)
    match /metadata/counters {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ultimoNumeroFallero == 1;
      allow update: if request.auth != null
        && request.resource.data.ultimoNumeroFallero == resource.data.ultimoNumeroFallero + 1;
    }

    // Directorio: copia reducida (uid, nombre, apellidos, numeroFallero, fechaNacimiento, hijos[{nombre, fechaNacimiento}]) para el buscador
    // de acompañantes. Lo lee cualquier usuario autenticado; sólo staff escribe libremente.
    match /directorio/{uid} {
      allow read: if request.auth != null;
      allow write: if isPrivileged();

      // Sincronización de la propia ficha (registro / edición de hijos desde la app):
      // sólo SU documento, sólo estos campos, y nombre/apellidos/número idénticos a su perfil.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'apellidos', 'numeroFallero', 'fechaNacimiento', 'hijos'])
        && request.resource.data.uid == uid
        && request.resource.data.nombre == getAfter(/databases/$(database)/documents/falleros/$(uid)).data.nombre
        && request.resource.data.apellidos == getAfter(/databases/$(database)/documents/falleros/$(uid)).data.get('apellidos', '')
        && request.resource.data.numeroFallero == getAfter(/databases/$(database)/documents/falleros/$(uid)).data.get('numeroFallero', null)
        && request.resource.data.fechaNacimiento == getAfter(/databases/$(database)/documents/falleros/$(uid)).data.get('fechaNacimiento', '');
    }

    // Anuncios: cualquier fallero autenticado lee; admins y directiva escriben
    match /anuncios/{docId} {
      allow read:  if request.auth != null;
      allow write: if isPrivileged();
    }

    // Eventos: cualquier fallero autenticado lee; admins y directiva escriben
    match /eventos/{docId} {
      allow read:  if request.auth != null;
      allow write: if isPrivileged();
    }

    // FCM tokens: cada usuario gestiona el suyo; privilegiados pueden leer todos (para enviar push)
    match /fcm_tokens/{userId} {
      allow read:   if request.auth != null && (request.auth.uid == userId || isPrivileged());
      allow write:  if request.auth != null && request.auth.uid == userId;
    }

    // Inscripciones: fallero autenticado crea la suya y borra/edita las suyas; admins gestionan todo
    match /inscripciones/{docId} {
      allow read:   if request.auth != null;

      // ¿El evento cobra online (Stripe)? En esos eventos TODA inscripción creada desde la app nace
      // como 'pendiente': no cuenta como inscrita ni da acceso hasta que el webhook (Admin SDK)
      // confirme el cobro (pagado:true). Así nadie puede inscribirse —ni meter externos— sin pagar.
      function eventoCobraOnline(eventId) {
        return get(/databases/$(database)/documents/eventos/$(eventId)).data.get('pagoApp', false) == true;
      }

      // Campos que el usuario NUNCA puede escribir: financieros y checkInDelegadoIds (sólo el webhook,
      // con Admin SDK, que ignora estas reglas, o admin/directiva) y de check-in (ver selfCheckIn).
      // create: el dueño no puede incluirlos; staff sí (inscripciones manuales).
      allow create: if request.auth != null
        && (isPrivileged()
            || crearV2()
            || (request.resource.data.uid == request.auth.uid
                && !request.resource.data.keys().hasAny([
                     'pagado', 'pagadoAt', 'stripePaymentId', 'totalNeto',
                     'totalConComision', 'gastosGestion', 'checkInDelegadoIds',
                     'checkInEstado', 'checkIn', 'checkInAt'])
                && (!eventoCobraOnline(request.resource.data.eventId)
                    || request.resource.data.get('estadoPago', '') == 'pendiente')));

      // Check-in desde la app (Fast Track), sobre una inscripción PAGADA:
      //   · cualquier titular o beneficiario: SU PROPIA entrada;
      //   · el titular además: la de sus invitados sin app (ids en checkInDelegadoIds, fijados por el webhook).
      // Sólo se pueden AÑADIR entradas: nunca deshacer ni sobrescribir (eso es del staff).
      // La hora de la propia entrada es la del servidor (request.time).
      function selfCheckIn() {
        let me      = request.auth.uid;
        let before  = resource.data.get('checkInEstado', {});
        let after   = request.resource.data.get('checkInEstado', {});
        let changed = after.diff(before).affectedKeys();
        let allowed = resource.data.uid == me
          ? [me].concat(resource.data.get('checkInDelegadoIds', []))
          : [me];
        return resource.data.get('pagado', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkInEstado'])
          && changed.size() > 0
          && changed.hasOnly(allowed)
          && before.keys().toSet().intersection(changed).size() == 0
          && (!changed.hasAny([me])
              || (after[me].keys().hasOnly(['checkIn', 'checkInAt'])
                  && after[me].checkIn == true
                  && after[me].checkInAt == request.time));
      }

      allow update: if request.auth != null
        && (isPrivileged()
            || actualizarV2()
            || ((resource.data.uid == request.auth.uid
                 || request.auth.uid in resource.data.get('beneficiariosUids', []))
                && selfCheckIn())
            || (resource.data.uid == request.auth.uid
                // nunca: campos financieros, de check-in, estadoPago, ni reasignar a otro evento/usuario
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                     'pagado', 'pagadoAt', 'stripePaymentId', 'totalNeto',
                     'totalConComision', 'gastosGestion', 'checkInDelegadoIds',
                     'checkInEstado', 'checkIn', 'checkInAt',
                     'estadoPago', 'uid', 'eventId'])
                // inscripción ya pagada: congelar personas y acompañantes
                && !(resource.data.get('pagado', false) == true
                     && request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'totalPersonas', 'beneficiarios', 'beneficiariosUids',
                          'acompañantes', 'acompañantesAdultos', 'acompañantesNinos']))));

      // Una inscripción pagada sólo la puede borrar el staff (la directiva gestiona las bajas).
      allow delete: if request.auth != null
        && (isPrivileged()
            || (resource.data.uid == request.auth.uid
                && resource.data.get('pagado', false) != true)
            || borrarV2());

      // ── Modelo v2: checkout de GRUPO ─────────────────────────────────────────────────────
      // Un documento por asistente (modelo: 2), agrupados por pedidoId y con pagadorUid = quien
      // los creó. Ids deterministas: `${eventId}_${asistenteKey}` (persona del censo) o
      // `${eventId}_${pedidoId}_${n}` (sin app / invitado) → Firestore impide duplicados.
      function esV2(d) { return d.get('modelo', 0) == 2; }

      // CREAR para otros: sólo en eventos que NO se cobran online (los de pago los crea el
      // servidor en /api/createGroupCheckout, que además comprueba aforo y duplicados).
      // Nace sin pagar, sin check-in y con la hora del servidor; pagadorUid = yo.
      function crearV2() {
        let d = request.resource.data;
        return esV2(d)
          && d.pagadorUid == request.auth.uid
          && !eventoCobraOnline(d.eventId)
          && d.keys().hasOnly(['modelo', 'eventId', 'pedidoId', 'pagadorUid', 'pagadorNombre', 'tipo',
                               'asistenteUid', 'asistenteKey', 'asistenteNombre', 'categoria',
                               'precioNetoCent', 'pagado', 'estadoPago', 'checkIn', 'createdAt', 'nota', 'alergias'])
          && d.tipo in ['titular', 'familiar', 'fallero', 'hijo', 'invitado']
          && d.categoria in ['adulto', 'nino']
          && ((d.tipo == 'titular') == (d.get('asistenteUid', null) == request.auth.uid))
          && d.pagado == false
          && d.get('estadoPago', null) == null
          && d.checkIn == false
          && d.createdAt == request.time
          && (d.get('asistenteKey', null) == null
                ? docId.matches(d.eventId + '_' + d.pedidoId + '_[0-9]+')
                : docId == d.eventId + '_' + d.asistenteKey);
      }

      // EDITAR: pagador o asistente → sólo nota/alergias. Check-in Fast Track (inscripción pagada):
      // el propio asistente, o el pagador para quien no tiene app (hijos, sin app, invitados).
      // Nunca campos financieros ni deshacer un check-in (eso es del staff).
      function actualizarV2() {
        let r = resource.data;
        let n = request.resource.data;
        let changed = n.diff(r).affectedKeys();
        let soyPagador   = r.pagadorUid == request.auth.uid;
        let soyAsistente = r.get('asistenteUid', null) == request.auth.uid;
        return esV2(r)
          && (((soyPagador || soyAsistente) && changed.hasOnly(['nota', 'alergias']))
              || (r.get('pagado', false) == true
                  && r.get('checkIn', false) != true
                  && (soyAsistente || (soyPagador && r.get('asistenteUid', null) == null))
                  && changed.hasOnly(['checkIn', 'checkInAt'])
                  && n.checkIn == true
                  && n.checkInAt == request.time));
      }

      // BORRAR: nunca si está pagada (política de no devolución; sólo staff). Si no lo está:
      // el pagador, el propio asistente (nadie puede apuntarme sin que pueda quitarme), o
      // cualquiera si es una reserva pendiente caducada (>15 min) que bloquea la plaza.
      function borrarV2() {
        let r = resource.data;
        return esV2(r)
          && r.get('pagado', false) != true
          && (r.pagadorUid == request.auth.uid
              || r.get('asistenteUid', null) == request.auth.uid
              || (r.get('estadoPago', null) == 'pendiente'
                  && request.time > r.createdAt + duration.value(15, 'm')));
      }
    }

    // Pedidos (checkout de grupo): los escribe sólo el servidor. El pagador lee el suyo
    // (la app espera a que el webhook lo ponga en estado 'pagado').
    match /pedidos/{pedidoId} {
      allow read: if request.auth != null
        && (isPrivileged() || resource.data.pagadorUid == request.auth.uid);
      allow write: if false;
    }

    // Cobros que requieren revisión manual (los escribe sólo el webhook con Admin SDK)
    match /pagosPendientesRevision/{piId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    // Votaciones: todos leen; admins crean/eliminan/cierran; falleros pueden incrementar contadores al votar
    match /votaciones/{pollId} {
      allow read: if request.auth != null;
      allow create, delete: if isPrivileged();
      // Privileged: full update. Authenticated users: only increment vote counters on active polls.
      allow update: if isPrivileged()
        || (request.auth != null
            && resource.data.activa == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultados', 'totalVotos']));

      match /votos/{voterId} {
        // Own vote always readable (to know you already voted).
        // Other votes only visible to privileged users on non-anonymous polls.
        allow read: if request.auth != null
          && (request.auth.uid == voterId
              || (isPrivileged()
                  && !get(/databases/$(database)/documents/votaciones/$(pollId)).data.isAnonymous));
        allow create: if request.auth != null && request.auth.uid == voterId;
        allow update, delete: if false;
      }
    }
  }
}
