rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/falleros/$(request.auth.uid)).data.rol == 'admin';
    }
    function isDirectiva() {
      return request.auth != null
        && get(/databases/$(database)/documents/falleros/$(request.auth.uid)).data.rol == 'directiva';
    }
    function isPrivileged() { return isAdmin() || isDirectiva(); }

    // Falleros: cada fallero lee/actualiza su propio perfil; admins y directiva leen todos
    match /falleros/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isPrivileged());
      // El número de fallero solo puede asignarlo el contador atómico (misma transacción)
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.numeroFallero ==
           getAfter(/databases/$(database)/documents/metadata/counters).data.ultimoNumeroFallero;
      // El usuario no puede modificar su número de fallero; solo un admin
      allow update: if request.auth != null
        && ((request.auth.uid == userId
             && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['numeroFallero']))
            || isAdmin());
    }

    // Contadores globales: lectura/escritura solo para incrementar en +1 (transacción de registro)
    match /metadata/counters {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ultimoNumeroFallero == 1;
      allow update: if request.auth != null
        && request.resource.data.ultimoNumeroFallero == resource.data.ultimoNumeroFallero + 1;
    }

    // Anuncios: cualquier fallero autenticado lee; admins y directiva escriben
    match /anuncios/{docId} {
      allow read:  if request.auth != null;
      allow write: if isPrivileged();
    }

    // Eventos: cualquier fallero autenticado lee; admins y directiva escriben
    match /eventos/{docId} {
      allow read:  if request.auth != null;
      allow write: if isPrivileged();
    }

    // FCM tokens: cada usuario gestiona el suyo; privilegiados pueden leer todos (para enviar push)
    match /fcm_tokens/{userId} {
      allow read:   if request.auth != null && (request.auth.uid == userId || isPrivileged());
      allow write:  if request.auth != null && request.auth.uid == userId;
    }

    // Inscripciones: fallero autenticado crea la suya y borra/edita las suyas; admins gestionan todo
    match /inscripciones/{docId} {
      allow read:   if request.auth != null;
      // Campos que el usuario NUNCA puede escribir: financieros (sólo webhook con Admin SDK,
      // que ignora estas reglas, o admin/directiva) y de check-in (sólo staff).
      // create: el dueño no puede incluirlos; staff sí (inscripciones manuales).
      allow create: if request.auth != null
        && (isPrivileged()
            || (request.resource.data.uid == request.auth.uid
                && !request.resource.data.keys().hasAny([
                     'pagado', 'pagadoAt', 'stripePaymentId', 'totalNeto',
                     'totalConComision', 'gastosGestion',
                     'checkInEstado', 'checkIn', 'checkInAt'])));
      // update: el dueño no puede añadir, modificar ni borrar esos campos.
      allow update: if request.auth != null
        && (isPrivileged()
            || (resource.data.uid == request.auth.uid
                // nunca: campos financieros, de check-in, ni reasignar la inscripción a otro evento/usuario
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                     'pagado', 'pagadoAt', 'stripePaymentId', 'totalNeto',
                     'totalConComision', 'gastosGestion',
                     'checkInEstado', 'checkIn', 'checkInAt',
                     'uid', 'eventId'])
                // inscripción ya pagada: congelar personas y acompañantes
                && !(resource.data.get('pagado', false) == true
                     && request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'totalPersonas', 'beneficiarios', 'beneficiariosUids',
                          'acompañantes', 'acompañantesAdultos', 'acompañantesNinos']))));
      // Una inscripción pagada sólo la puede borrar el staff (la directiva gestiona las bajas).
      allow delete: if request.auth != null
        && (isPrivileged()
            || (resource.data.uid == request.auth.uid
                && resource.data.get('pagado', false) != true));
    }

    // Cobros que requieren revisión manual (los escribe sólo el webhook con Admin SDK)
    match /pagosPendientesRevision/{piId} {
      allow read: if isPrivileged();
      allow write: if false;
    }

    // Votaciones: todos leen; admins crean/eliminan/cierran; falleros pueden incrementar contadores al votar
    match /votaciones/{pollId} {
      allow read: if request.auth != null;
      allow create, delete: if isPrivileged();
      // Privileged: full update. Authenticated users: only increment vote counters on active polls.
      allow update: if isPrivileged()
        || (request.auth != null
            && resource.data.activa == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultados', 'totalVotos']));

      match /votos/{voterId} {
        // Own vote always readable (to know you already voted).
        // Other votes only visible to privileged users on non-anonymous polls.
        allow read: if request.auth != null
          && (request.auth.uid == voterId
              || (isPrivileged()
                  && !get(/databases/$(database)/documents/votaciones/$(pollId)).data.isAnonymous));
        allow create: if request.auth != null && request.auth.uid == voterId;
        allow update, delete: if false;
      }
    }
  }
}
